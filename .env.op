# Secret references resolved by the 1Password CLI at launch:
#   op run --env-file=.env.op -- uv run python -m pipeline.backfill
# Nothing in this file is secret; the key itself never touches disk.
HANDLE_HMAC_KEY=op://Dev/play-rough-pipeline HANDLE_HMAC_KEY/password
PRA_BUCKET=playroughanalytics-prod-rawlogsbucketf3441e60-cqwauxrcqlls
PRA_PREFIX=parsed/
AWS_REGION=us-west-2
# Filled in once the queue exists (the CDK stack output); the consumer is the
# only command that reads it, so an empty value leaves backfills working.
PRA_QUEUE_URL=
