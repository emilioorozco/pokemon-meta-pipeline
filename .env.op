# Secret and identifier references resolved by the 1Password CLI at launch:
#   op run --env-file=.env.op -- uv run python -m pipeline.backfill
# Nothing in this file is a value; every line is an op:// reference. The
# vault item "play-rough-pipeline config" holds the bucket, queue and role
# identifiers so the repository carries no account or resource names.
HANDLE_HMAC_KEY=op://Dev/play-rough-pipeline HANDLE_HMAC_KEY/password
ANTHROPIC_API_KEY=op://Dev/play-rough-pipeline LLM_API_KEY/password
PRA_BUCKET=op://Dev/play-rough-pipeline config/prod_bucket
PRA_QUEUE_URL=op://Dev/play-rough-pipeline config/prod_queue_url
PRA_INSIGHTS_TABLE=op://Dev/play-rough-pipeline config/prod_insights_table
PRA_PREFIX=parsed/
AWS_REGION=us-west-2
