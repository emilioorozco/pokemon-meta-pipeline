# The serving application as a Lambda container image: `/ask` and `/predict`
# behind a function URL, reading the lake.
#
#   docker build -f Dockerfile.agent -t pipeline-agent .
#   docker run --rm -p 9000:8080 -e PIPELINE_DATA_DIR=/mnt/lake -v "$PWD/scratch:/mnt/lake" \
#     -e ANTHROPIC_API_KEY=not-a-real-key pipeline-agent
#   curl -s localhost:9000/2015-03-31/functions/function/invocations -d @event.json
#
# A fourth image file, beside `Dockerfile` (the stages), `Dockerfile.serve`
# (the compose-era predictor) and `Dockerfile.lambda` (the event consumer), and
# for the same reason each of those is its own: the base differs. This one
# starts from the AWS runtime interface image, whose client turns an invocation
# into a call to `pipeline.lambda_serve.handler`. `Dockerfile.serve` stays
# exactly as it is; it is the image `compose.yaml` builds next to the tracking
# server and it carries the `ml` extra only, so `/ask` answers 503 in it. This
# one is the deployed one and carries the agent as well.
#
# Three stages, one dependency layer. `deps` installs what the function runs,
# `embedder` adds the Hugging Face client on top of it and fetches the query
# embedder's files, and the final stage goes back to `deps` and copies those
# files across. The client, and the egress it needs, exist for one `RUN` and
# are in nothing that is deployed.
#
# x86_64 explicitly, for the reason `Dockerfile.lambda` gives: the function is
# defined that way in the application's stack, and a manifest built on an arm64
# laptop would be refused at update time rather than at build time.
FROM --platform=linux/amd64 public.ecr.aws/lambda/python:3.12 AS deps

# LightGBM links against the OpenMP runtime, and the Lambda base image does not
# ship it. One package, and without it `/predict` fails at model load with a
# missing `libgomp.so.1` rather than with anything that names LightGBM.
RUN dnf install -y libgomp && dnf clean all && rm -rf /var/cache/dnf

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# The dependency layer. `ml` brings LightGBM, MLflow, scikit-learn, pandas,
# matplotlib, FastAPI and the OpenTelemetry stack, which is `/predict` and the
# application itself; `serve` brings LangChain, the Anthropic client, ONNX
# Runtime, the tokenizer and the Lambda adapter, which is `/ask`.
#
# **`agent` is deliberately not installed here, and that is the change.** It is
# the extra that carries `sentence-transformers` and torch, and on this
# function the Python import of torch and transformers was 105 s of every cold
# `GET /warm`: not the weights, which loaded in under three seconds after, but
# thousands of small files paged in over image layers that Lambda fetches the
# first time something touches them. The serving path embeds the member's
# question with `pipeline.query_embedder.OnnxEmbedder`, which is the same
# network through ONNX Runtime; `sentence-transformers` is now only the offline
# index build, which runs on a nightly runner with no cold start to pay.
# `tests/test_serve_imports.py` fails if any of the three comes back.
#
# `uv export` rather than a hand-written list, for the reason
# `Dockerfile.lambda` gives: the versions are the ones `uv.lock` pins and the
# ones CI tested, and a new transitive dependency arrives without anyone
# remembering to add it. No dev group, so no pytest, no moto and no pyspark;
# no `spark`, `dbt` or `orchestration` extras either.
#
# The PyTorch CPU index that `pyproject.toml` declares is still there and still
# applies to `agent`; nothing installed here resolves from it, so this export
# no longer needs `--emit-index-url` or `--index-strategy unsafe-best-match`.
#
# `--compile-bytecode` trades image size for cold start. Writing `.pyc` for
# MLflow and LangChain at build time is a layer's worth of size and it is
# several seconds off the first import in a fresh execution environment, which
# is the number this function is judged on.
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-dev --no-emit-project --no-hashes \
      --extra ml --extra serve \
      --format requirements-txt > /tmp/requirements.txt \
    && uv pip install --python /var/lang/bin/python3.12 --no-cache --compile-bytecode \
      -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

# DuckDB reads the warehouse, and over an `s3://` lake the gold views inside it
# are `read_parquet('s3://...')`, so the connection needs `httpfs` and `aws`.
# DuckDB installs those from its own network repository into `$HOME/.duckdb` on
# first use, which under Lambda would be a download on the critical path of the
# first question. They are installed here instead, into a directory of the
# image, and `pipeline.lambda_serve.prime_duckdb_extensions` copies them into
# `$HOME` once per container.
ENV PRA_DUCKDB_EXTENSION_CACHE=/opt/duckdb/.duckdb
RUN mkdir -p /opt/duckdb \
    && HOME=/opt/duckdb /var/lang/bin/python3.12 -c \
      "import duckdb; c = duckdb.connect(); c.execute('INSTALL httpfs'); c.execute('INSTALL aws')" \
    && test -d /opt/duckdb/.duckdb/extensions

# ---------------------------------------------------------------------------
# The embedding model, fetched where it cannot follow anything into the image.
#
# The retriever embeds the question locally, so a cold container that had to
# pull the model from Hugging Face before it could answer would be a function
# that needs egress, a mirror that can be down, and seconds nobody is paying
# for. `scripts/export_query_embedder.py` writes the three files the serving
# embedder reads: `BAAI/bge-small-en-v1.5` publishes `onnx/model.onnx` in its
# own repository, 133,093,490 bytes in one file with no external data, so the
# script downloads that and `tokenizer.json` and records the model and its
# pooling in an `embedder.json` beside them. The build fails here if any of it
# cannot be fetched, rather than the first question failing in production.
#
# `huggingface_hub` is installed in this stage and this stage only. The final
# image copies the directory and not the client, so nothing deployed can reach
# Hugging Face at all, which is the stronger version of the offline flags the
# previous build set after the download.
FROM deps AS embedder
COPY pipeline ./pipeline
COPY scripts ./scripts
RUN uv pip install --python /var/lang/bin/python3.12 --no-cache "huggingface-hub>=0.24" \
    && PYTHONPATH=. /var/lang/bin/python3.12 scripts/export_query_embedder.py --out /opt/embedder \
    && test -s /opt/embedder/model.onnx \
    && test -s /opt/embedder/tokenizer.json \
    && test -s /opt/embedder/embedder.json

# ---------------------------------------------------------------------------
FROM deps

# The package, and the model beside it. `PRA_QUERY_EMBEDDER_DIR` is the one
# variable `pipeline.config` reads to find the files; everything downstream of
# it, including the refusal when the index was built with another model, comes
# off the `embedder.json` in that directory.
COPY pipeline ${LAMBDA_TASK_ROOT}/pipeline
COPY --from=embedder /opt/embedder /opt/embedder
ENV PRA_QUERY_EMBEDDER_DIR=/opt/embedder
RUN /var/lang/bin/python3.12 -m compileall -q "${LAMBDA_TASK_ROOT}/pipeline" \
    && rm -f pyproject.toml uv.lock /usr/local/bin/uv

# `/tmp` is the only writable path in a Lambda execution environment, and three
# things want a home directory: DuckDB's extension cache, matplotlib's font
# cache and anything else that reaches for `~`. Pointing `HOME` at `/tmp` costs
# nothing (the ephemeral volume is 2 GB and the warehouse copy is the only
# large thing in it) and turns three possible read-only-filesystem failures
# into none. `TMPDIR` is already `/tmp` under Lambda, which is where
# `pipeline.storage`'s `tempfile` scratch directories land.
ENV HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1

# Everything else is the function's environment, set in the application's
# stack: PIPELINE_DATA_DIR (the s3:// lake root), AGENT_KEYS_SECRET_ARN, the
# four PRA_SQL_GATE_* settings and PRA_LOG_FORMAT. AWS_REGION is the
# platform's. See docs/agent-service.md.
CMD ["pipeline.lambda_serve.handler"]
