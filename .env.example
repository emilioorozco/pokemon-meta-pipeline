# Source: Play Rough Analytics parsed-game blobs in S3.
# The bucket holds parsed/{userId}/{gameId}.json; the pipeline reads it and never writes to it.
# PRA_BUCKET=
# PRA_PREFIX=parsed/
# AWS_REGION=us-west-2
# AWS_PROFILE=            # optional: named profile from ~/.aws/config

# Event-driven ingest only: the SQS queue the bucket notification writes to.
# Required by `python -m pipeline.consume`; the backfill runs without it.
# PRA_QUEUE_URL=

# Secret used to anonymize player handles before anything is written. Never commit it.
# HANDLE_HMAC_KEY=

# Where this pipeline writes its lake + warehouse (default: ./data)
# PIPELINE_DATA_DIR=./data

# Spark master for the silver stage (default: local[*]); --master overrides it.
# PRA_SPARK_MASTER=local[*]

# Log rendering: json (one object per line) or console (one compact line).
# Unset, the stages choose: console when stderr is a terminal, json otherwise.
# PRA_LOG_FORMAT=json

# One identifier for a whole orchestrated run. Every stage picks it up, puts it
# on every log line and writes it into its run_metrics row, so one DAG run is
# one filter. Unset, each command invents its own.
# PRA_RUN_ID=

# Which half of the ingest is live. `backfill` (the default when unset) lists
# the bucket and lands what it finds; `consumer` means the event-driven ingest
# is already writing bronze, so `python -m pipeline.run_all` and the Airflow DAG
# both turn the backfill step into a logged no-op instead of a second pass.
# PRA_INGEST_MODE=backfill

# The local Airflow web login (`docker compose up -d airflow`, port 8080).
# Local only: the container is not exposed off the machine and this is not a
# secret. Unset, the user is admin/admin.
# AIRFLOW_ADMIN_PASSWORD=admin

# Where the DAG's tasks record their MLflow runs. Unset, compose points them at
# the `mlflow` service; set it empty to use the plain directory under data/mlruns.
# AIRFLOW_MLFLOW_TRACKING_URI=http://mlflow:5000

# Legacy (deprecated corpus stage, see docs/adr/0001): SOURCE_DATA_DIR=

# Where the model stage records its runs and its registered versions. Unset,
# `python -m pipeline.train`, `pipeline.promote` and `pipeline.serve` all use a
# plain directory at ./data/mlruns, which needs no server.
# Point it at the compose service to get the MLflow user interface instead
# (`docker compose up -d mlflow`, then open http://localhost:5000).
# MLFLOW_TRACKING_URI=http://localhost:5000

# Where the serving stage exports its spans. Unset, or naming a host that does
# not resolve, tracing is a no-op and the service starts exactly as it would
# without it. compose points the `predict` service at the collector that comes
# up with `docker compose --profile observability up -d --build predict grafana`.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Demonstrations only. Set it and `python -m pipeline.serve` answers `/predict`
# from a hand-written logistic on the prize lead instead of the registry, which
# is what makes the tracing and dashboard demo runnable when nothing holds the
# production alias. It reports `stub` as its version and its alias everywhere.
# It is never a model.
# PRA_SERVE_STUB_MODEL=1
