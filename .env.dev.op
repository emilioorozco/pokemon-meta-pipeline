# Dev environment: op run --env-file=.env.dev.op -- ...
# op run --env-file overrides the shell, so a second file is the clean way
# to target dev; .env.op stays pointed at prod. References only, no values.
HANDLE_HMAC_KEY=op://Dev/play-rough-pipeline HANDLE_HMAC_KEY/password
ANTHROPIC_API_KEY=op://Dev/play-rough-pipeline LLM_API_KEY/password
# The Jev (TypeSafe AI) key for the optional SQL safety gate; only read when
# PRA_SQL_GATE=jev. Every other command runs without it.
JEV_API_KEY=op://Dev/play-rough-pipeline JEV_API_KEY/password
PRA_BUCKET=op://Dev/play-rough-pipeline config/dev_bucket
PRA_QUEUE_URL=op://Dev/play-rough-pipeline config/dev_queue_url
PRA_INSIGHTS_TABLE=op://Dev/play-rough-pipeline config/dev_insights_table
PRA_PREFIX=parsed/
AWS_REGION=us-west-2
